{% if section.blocks.size > 0 %}
  {{ 'faq.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'faq.js' | asset_url }}" defer="defer"></script>

  <section class="faq-wrapper">
    <div class="faq-inner">

      {% if section.settings.heading != blank %}
        <div class="faq-header">
          <h2>{{ section.settings.heading }}</h2>
        </div>
      {% endif %}

      <div class="faq-grid">
        {% for block in section.blocks %}
          <article class="faq-card" {{ block.shopify_attributes }}>
            
            <button 
              class="faq-card__trigger" 
              aria-expanded="false" 
              type="button"
            >
              <div class="faq-card__title">
                {{ block.settings.question }}
              </div>

              <span class="faq-card__icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                  <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
                  <path d="M8 12H16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  <path class="faq-card__vertical" d="M12 8V16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </span>
            </button>

            <div class="faq-card__content">
              <div class="faq-card__body">
                {{ block.settings.answer }}
              </div>
            </div>

          </article>
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Panel Heading",
      "default": "Frequently Asked Questions"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "Item",
      "limit": 20,
      "settings": [
        {
          "type": "richtext",
          "id": "question",
          "label": "Question",
          "default": "<p>Some Question.</p>"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Some Answer.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ"
    }
  ]
}
{% endschema %}
